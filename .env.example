# Copy to .env.local and fill in from your Supabase project
# (Project Settings -> API Keys / Data API). .env.local is git-ignored.
# Never commit real values and never paste them into chat or issues.

# --- Used by the Next.js app (safe for the browser; RLS protects data) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or, on older projects, the anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public URL of this app, used in password-reset links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Used ONLY by local scripts in scripts/ (never by the app) ---
# Secret key (sb_secret_...) or, on older projects, the service_role key.
# It bypasses Row Level Security: keep it on your machine only.
SUPABASE_SECRET_KEY=

# --- Fictional test data (development/test project only) ---
# Password given to every fictional test account by `npm run seed:test`.
# Choose your own, at least 16 characters.
SEED_TEST_PASSWORD=
# Must be exactly "yes" for the seed script to run.
SEED_TARGET_IS_TEST_PROJECT=no
